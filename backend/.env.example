# Copy to .env (never commit .env). Keys stay on the backend only.
ASTROMETRY_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Comma-separated frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173
# Max upload size in MB (default 15)
MAX_UPLOAD_MB=15
# Where LocalStore keeps jobs + images when Supabase isn't configured (default: backend/storage)
STORAGE_DIR=
