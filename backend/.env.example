# Copy to .env (never commit .env). Keys stay on the backend only.
ASTROMETRY_API_KEY=
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Comma-separated frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173
# Max upload size in MB (default 15)
MAX_UPLOAD_MB=15
# Where LocalStore keeps jobs + images when Supabase isn't configured (default: backend/storage)
STORAGE_DIR=

# --- Plate solving (feature #2) ---
# auto = local solve-field if installed (Docker image), else the public astrometry.net API.
# local = never use the API | api = API only (e.g. Windows dev without Docker) | stub = fake result
SOLVER_MODE=auto
# Local solve limit in seconds (wall clock and CPU)
LOCAL_SOLVE_TIMEOUT_S=90
# Public API give-up time in seconds (keep under the frontend's 6 minute wait)
API_SOLVE_TIMEOUT_S=240
# The Docker image sets ASTROMETRY_INDEX_DIR and ASTROMETRY_CONFIG itself. Don't add them here:
# an empty value in .env would override the image's setting and break the local solver.

# 0 = hide the fake sample dots on /map (default 1: shown after the real points)
MAP_SAMPLE_POINTS=1
